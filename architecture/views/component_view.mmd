%% Component view: agents, checks, jobs and how they connect.
%% Solid arrow = control or data flow. Dashed arrow = uses / reads / writes.
flowchart TB
    subgraph TRIG["Triggers · one run per issue at a time"]
        T1["Issue labeled autose"]
        T2["/autose comment<br/>owner, member or collaborator, not a bot"]
        T3["Manual or Route dispatch<br/>issue, optional restart stage 1-4"]
    end

    STATE[("Run state store<br/>issue snapshot, target stage, done flag,<br/>stage outputs, attempt summaries, trajectories")]
    MIRROR["Issue mirror comment<br/>for humans, never read back"]

    subgraph J1["Orchestrator job · state machine"]
        direction TB
        S1["S1 Requirements agent<br/>adapted A1 skill<br/>vague: states assumptions<br/>very vague: rejects with questions"]
        G1{{"G1 spec schema<br/>+ LLM testability judge<br/>judge model differs from S1 model"}}
        S23["S2+S3 Design + implementation agent<br/>one conversation, paused for G2"]
        G2{{"G2 at most 10 targets<br/>existing symbol found and kind matches,<br/>or new symbol in an existing module"}}
        G3{{"G3 install + import · lint, no new problems<br/>changes stay inside design targets<br/>no workflow, config or lockfile edits<br/>existing tests unedited · no secrets"}}
        S4["S4 Testing agent<br/>phase 1: clean copy + interface list,<br/>no design reasoning, implementation hidden<br/>phase 2: copy with implementation, setup fixes only"]
        G4{{"G4 no new failures vs baseline<br/>every acceptance criterion has a passing test<br/>that calls a target and asserts<br/>existing tests and phase-1 asserts unchanged"}}
        S1 --> G1 --> S23
        S23 -->|design| G2 -->|pass| S23
        S23 -->|diff| G3 --> S4 --> G4
        G1 -.->|fail: one re-ask| S1
        G2 -.->|fail: one re-ask| S23
        G3 -->|fail: S3 max 2| S23
        G4 -->|code fault: S3 max 2, then S2 once| S23
        G4 -->|test fault: S4 once| S4
    end

    subgraph J2["Release job · script only"]
        SEC{{"Secret scan on diff"}}
        S5["S5 merge base branch, push (never force)<br/>open PR with minimal description"]
        G5{{"G5 PR open + CI green<br/>within 10 min"}}
        SEC --> S5 --> G5
    end

    subgraph J3["Review job · read-only checkout"]
        TST["Run tests in sandbox<br/>workspace holds only the PR commit"]
        S6["S6 Reviewer agent<br/>sees issue snapshot, PR diff, repo at PR head<br/>no spec, design, notes or PR description"]
        G6{{"G6 evidence check<br/>cited lines exist, cited commands ran<br/>approve needs own test run,<br/>no new test failures and no major or blocker finding"}}
        TST --> S6 --> G6
        G6 -.->|fail: one re-ask| S6
    end

    subgraph J4["Route job · script · always runs"]
        RT{"Job results, verdict,<br/>classification, review round < 2?"}
    end

    HUMAN(["Human merges or closes"])
    STOP(["Stop: one redacted stop comment<br/>with explanation; re-trigger resumes at S4,<br/>or re-releases for a new review"])

    TOOLS["Agent runtime<br/>bash-only agent loop in sandbox container<br/>no secrets, no GitHub token<br/>step, time, token and output caps"]
    MODELS["Model chains per role<br/>provider fallback, key rotation, waits on rate limits<br/>reviewer chain disjoint from code-writing roles"]
    GH["GitHub client<br/>PAT: push + PR only<br/>default token: comments, labels, dispatch"]
    EXP["Experiment workflow<br/>manual, read-only, posts nothing<br/>one pinned model per role"]

    T1 & T2 & T3 --> J1
    STATE <-.-> J1
    STATE -.-> J2
    STATE -.->|issue snapshot + baseline only| J3
    STATE <-.-> J4
    J1 -.-> MIRROR
    J4 -.-> MIRROR
    G4 -->|pass| J2
    G5 -->|pass| J3
    G6 -->|verdict + label| J4
    RT -->|approved, or 2 rounds used| HUMAN
    RT -->|changes requested:<br/>earliest of spec, design, code, test| T3
    RT -->|check failed, cap reached, crash,<br/>timeout or cancel| STOP

    G1 & G2 & SEC & S5 & G5 & G6 -->|fail| J4
    G3 & G4 -->|retries used up| J4
    S1 -->|very vague| J4
    J1 -->|cap reached| J4

    TOOLS -.-> S1 & S23 & S4 & S6
    MODELS -.-> TOOLS & G1
    GH -.-> J1 & J2 & J3 & J4
    EXP -.-> S1 & S6
